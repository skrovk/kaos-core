@@ -0,0 +1,163 @@
+"""APP03 application copies and explicit graph evidence for either OR branch."""
+
+import json
+import os
+import struct
+import tempfile
+import unittest
+from pathlib import Path
+
+from sim_env.graph_alternatives import evaluate_alternatives, run_alternatives
+
+INSTANCES = {"10": 2, "20": 0, "30": 1}
+
+
+def trace(branches=("A", "B"), *, complete=True):
+    rows = []
+    for branch in branches:
+        destination, instance = (20, 0) if branch == "A" else (30, 1)
+        for sequence in range(8):
+            payload = (
+                struct.pack("<II", sequence, sequence)
+                + bytes((sequence + i) & 255 for i in range(56))
+            ).hex()
+            for caller, direction in ((2, "PUT"), (instance, "GET")):
+                index = len(rows) + 1
+                rows.append(
+                    {
+                        "kind": "host_stdout",
+                        "device": 1,
+                        "line": f"CHANNEL {index} {100 + index} {caller} {direction} 10 {destination} 1 {payload}",
+                    }
+                )
+    if complete:
+        rows.append(
+            {"kind": "host_stdout", "device": 1, "line": f"CHANNEL_END {len(rows)} 0"}
+        )
+    return rows
+
+
+def phase(active):
+    return {"name": "test", "begin_us": 100, "end_us": 200, "active": list(active)}
+
+
+class AlternativeOracleTests(unittest.TestCase):
+    def evaluate(self, events, active=("A", "B")):
+        return evaluate_alternatives(events, (1,), INSTANCES, [phase(active)])
+
+    def test_both_branches_validate_independent_samples(self):
+        result = self.evaluate(trace())
+        self.assertEqual(result["status"], "passed")
+        self.assertEqual(result["phases"][0]["branches"]["A"]["unique_sequences"], 8)
+        self.assertEqual(result["phases"][0]["branches"]["B"]["unique_sequences"], 8)
+
+    def test_either_single_branch_passes_without_the_other(self):
+        for branch in ("A", "B"):
+            with self.subTest(branch=branch):
+                result = self.evaluate(trace((branch,)), (branch,))
+                self.assertEqual(result["status"], "passed")
+                self.assertEqual(result["phases"][0]["unexpected_copies"], 0)
+
+    def test_inactive_branch_copies_and_missing_active_branch_fail(self):
+        self.assertEqual(self.evaluate(trace(), ("A",))["status"], "failed")
+        self.assertEqual(self.evaluate(trace(("A",)))["status"], "failed")
+        self.assertEqual(self.evaluate(trace(()))["status"], "failed")
+
+    def test_corrupt_sample_is_rejected(self):
+        events = trace(("A",))
+        events[0]["line"] = events[0]["line"][:-2] + "ff"
+        with self.assertRaisesRegex(ValueError, "value or padding"):
+            self.evaluate(events, ("A",))
+
+    def test_wrong_instance_and_channel_are_rejected(self):
+        for old, new in ((" 2 PUT ", " 9 PUT "), (" 10 20 1 ", " 11 20 1 ")):
+            with self.subTest(change=new):
+                events = trace(("A",))
+                events[0]["line"] = events[0]["line"].replace(old, new)
+                with self.assertRaisesRegex(ValueError, "instance|channel"):
+                    self.evaluate(events, ("A",))
+
+    def test_complete_trace_with_unmatched_get_is_rejected(self):
+        events = trace(("A",))
+        # Preserve sequence completeness but replace the matching first PUT.
+        events[0]["line"] = events[0]["line"].replace(" 2 PUT ", " 0 GET ")
+        with self.assertRaisesRegex(ValueError, "preceding matching PUT"):
+            self.evaluate(events, ("A",))
+
+    def test_observation_loss_is_inconclusive(self):
+        result = self.evaluate(trace(complete=False))
+        self.assertEqual(result["status"], "inconclusive")
+        self.assertFalse(result["trace_complete"])
+
+    def test_repeated_get_does_not_satisfy_distinct_sample_requirement(self):
+        events = trace(("A",))
+        first_put, first_get = events[0]["line"], events[1]["line"]
+        for i, event in enumerate(events[:-1]):
+            fields = event["line"].split()
+            fields[-1] = (first_put if i % 2 == 0 else first_get).split()[-1]
+            event["line"] = " ".join(fields)
+        result = self.evaluate(events, ("A",))
+        self.assertEqual(result["status"], "failed")
+        self.assertEqual(result["phases"][0]["branches"]["A"]["unique_sequences"], 1)
+
+
+@unittest.skipUnless(
+    os.environ.get("KAOS_WORKLOAD_HOST"), "requires actual host and guests"
+)
+class AlternativeProcessTests(unittest.TestCase):
+    def check_flow(self, first):
+        with tempfile.TemporaryDirectory(prefix="kaos-alternatives-test-") as directory:
+            output = Path(directory) / "run"
+            result = run_alternatives(
+                os.environ["KAOS_WORKLOAD_HOST"],
+                Path(os.environ["KAOS_WORKLOAD_GUESTS"]) / "alternatives.wasm",
+                output,
+                first=first,
+                seed=42,
+            )
+            self.assertEqual(result["status"], "passed", result)
+            self.assertTrue(result["trace_complete"])
+            self.assertEqual(len(result["outcomes"]), 7)
+            self.assertTrue(all(o["report"][5] == 1 for o in result["outcomes"]))
+            initial = result["startup_report"]
+            joined = result["joined_report"]
+            self.assertEqual(initial[6] & 39, 39)  # commit/dispatch/start/success
+            self.assertEqual(joined[5], 1)
+            self.assertGreater(joined[4], initial[4])
+            first_index = 0 if first == "A" else 1
+            first_flags = initial[7][1 + 2 * first_index : 3 + 2 * first_index]
+            other_flags = initial[7][3 - 2 * first_index : 5 - 2 * first_index]
+            self.assertTrue(all(flags & 3 == 3 for flags in first_flags))
+            self.assertTrue(all(flags & 2 == 0 for flags in other_flags))
+            self.assertTrue(all(flags & 3 == 3 for flags in joined[7][1:]))
+            removed = result["outcomes"][3]["report"]
+            self.assertTrue(all(flags & 56 == 56 for flags in removed[7]))
+            other = "B" if first == "A" else "A"
+            self.assertEqual(
+                [p["active"] for p in result["windows"]], [[first], ["A", "B"], [other]]
+            )
+            self.assertEqual(result["remaining_instances_at_teardown"], [])
+            self.assertEqual(json.loads((output / "result.json").read_text()), result)
+            events = [
+                json.loads(line)
+                for line in (output / "events.jsonl").read_text().splitlines()
+            ]
+            cold_owner = 3 if first == "A" else 2
+            self.assertTrue(
+                any(
+                    e["kind"] == "packet_dropped"
+                    and e.get("source") == 1
+                    and e.get("destination") == cold_owner
+                    for e in events
+                )
+            )
+
+    def test_a_starts_b_joins_then_a_is_removed(self):
+        self.check_flow("A")
+
+    def test_b_starts_a_joins_then_b_is_removed(self):
+        self.check_flow("B")
+
+
+if __name__ == "__main__":
+    unittest.main()
