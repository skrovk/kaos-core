index 0000000..22698f3
--- /dev/null
+++ b/tmp/kaos-p8-alternatives-stage/sim_env/graph_alternatives.py
@@ -0,0 +1,272 @@
+"""APP03: either outgoing channel starts a source; the other can join later."""
+
+import argparse
+import json
+import struct
+import time
+from pathlib import Path
+
+from .graph_protocol import Channel, Endpoint, Node, Port
+from .graph_run import GraphRun
+from .graph_transport import CREATED
+from .graph_workloads import read_trace
+
+CHANNELS = {"A": (10, 20, 1), "B": (10, 30, 1)}
+
+
+def evaluate_alternatives(events, devices, instances, phases):
+    """Check complete copy observations, payloads, identities and phase gates."""
+    records, complete = read_trace(events, devices)
+    if not complete:
+        return {
+            "status": "inconclusive",
+            "trace_complete": False,
+            "reason": "incomplete channel trace",
+        }
+    instances = {int(k): v for k, v in instances.items()}
+    puts = {}
+    for record in records:
+        channel, data = record["channel"], record["payload"]
+        if channel not in CHANNELS.values():
+            raise ValueError("unexpected channel")
+        logical = channel[0] if record["direction"] == "PUT" else channel[1]
+        if record["instance"] != instances[logical]:
+            raise ValueError("unexpected concrete instance")
+        if len(data) != 64:
+            raise ValueError("fixture sample must contain 64 bytes")
+        sequence, value = struct.unpack_from("<II", data)
+        if value != sequence or data[8:] != bytes(
+            (sequence + offset) & 255 for offset in range(56)
+        ):
+            raise ValueError("incorrect fixture value or padding")
+        if record["direction"] == "PUT":
+            key = (channel, data)
+            puts[key] = min(
+                puts.get(key, record["timestamp_us"]), record["timestamp_us"]
+            )
+    for record in records:
+        if record["direction"] == "GET":
+            sent = puts.get((record["channel"], record["payload"]))
+            if sent is None or sent > record["timestamp_us"]:
+                raise ValueError("GET without a preceding matching PUT")
+
+    results = []
+    for phase in phases:
+        active = set(phase["active"])
+        if not active or not active <= CHANNELS.keys():
+            raise ValueError("phase must name active branches A and/or B")
+        if not 0 <= phase["begin_us"] < phase["end_us"]:
+            raise ValueError("phase must have increasing nonnegative times")
+        branches, unexpected = {}, 0
+        for name, channel in CHANNELS.items():
+            copies = [
+                r
+                for r in records
+                if r["channel"] == channel
+                and phase["begin_us"] <= r["timestamp_us"] < phase["end_us"]
+            ]
+            received = [
+                struct.unpack_from("<I", r["payload"])[0]
+                for r in copies
+                if r["direction"] == "GET"
+            ]
+            branches[name] = {
+                "received": len(received),
+                "unique_sequences": len(set(received)),
+            }
+            if name not in active:
+                unexpected += len(copies)
+        good = not unexpected and all(
+            branches[name]["unique_sequences"] >= 8 for name in active
+        )
+        results.append(
+            {
+                "name": phase["name"],
+                "status": "passed" if good else "failed",
+                "branches": branches,
+                "unexpected_copies": unexpected,
+            }
+        )
+    return {
+        "status": "passed"
+        if results and all(p["status"] == "passed" for p in results)
+        else "failed",
+        "trace_complete": True,
+        "observations": len(records),
+        "phases": results,
+        "scope": "eight distinct samples per active branch; no successful copies on inactive branches",
+    }
+
+
+def run_alternatives(host, guest, output, *, first="A", seed=0):
+    """Fresh three-device run: one branch, both branches, then the other only."""
+    if first not in CHANNELS:
+        raise ValueError("first must be A or B")
+    first_index = 0 if first == "A" else 1
+    other = "B" if first == "A" else "A"
+    cold_owner = 3 if first == "A" else 2
+    outcomes, phases = [], []
+    with GraphRun(host, output, (1, 2, 3), seed=seed, trace_channels=True) as run:
+        size, crc = run.add_artifact(b"alternatives", Path(guest).read_bytes())
+
+        def complete(request):
+            if run.submit(request).code != CREATED:
+                raise RuntimeError("alternative workload operation was not admitted")
+            report = run.wait(request)
+            outcomes.append(
+                {
+                    "operation": request.operation.value,
+                    "kind": int(request.kind),
+                    "report": report,
+                }
+            )
+            if report[5] != 1:
+                raise RuntimeError(
+                    f"alternative workload operation did not succeed: {report}"
+                )
+            return request
+
+        def node(logical, owner, role):
+            return Node(
+                logical,
+                owner,
+                b"alternatives",
+                size,
+                crc,
+                131072,
+                bytes([role]),
+                5_000_000,
+                3_000_000,
+                (Port(1, 0, 1, 64), Port(2, 1, 1, 64)),
+            )
+
+        def phase(name, active):
+            begin = time.monotonic_ns() // 1000
+            run.emit("workload_phase_begin", name=name, active=active)
+            time.sleep(0.25)
+            end = time.monotonic_ns() // 1000
+            run.emit("workload_phase_end", name=name)
+            phases.append(
+                {"name": name, "begin_us": begin, "end_us": end, "active": active}
+            )
+
+        def live_source(report):
+            if (
+                report is None
+                or report[5] != 1
+                or report[6] & 39 != 39
+                or len(report[7]) != 5
+                or report[7][0] != 1
+            ):
+                raise RuntimeError(f"missing live source startup evidence: {report}")
+
+        sink_a = complete(run.o.add_node(node(20, 2, 1)))
+        sink_b = complete(run.o.add_node(node(30, 3, 2)))
+        # Apply the partition before authorization; every packet type shares
+        # this directed policy. The reverse direction remains at its default.
+        run.network.set_link(1, cold_owner, loss=1)
+        channels = tuple(
+            Channel(
+                Endpoint(10, None, 1, 2),
+                Endpoint(logical, sink.instance, owner, 1),
+                1,
+                1,
+                64,
+                2,
+                5_000_000,
+            )
+            for logical, owner, sink in ((20, 2, sink_a), (30, 3, sink_b))
+        )
+        source = complete(
+            run.o.add_node(
+                node(10, 1, 0),
+                channels=channels,
+                predicate_tokens=b"\x02\x00\x02\x01\x04\x00",
+            )
+        )
+        startup = outcomes[-1]["report"]
+        live_source(startup)
+        active_flags = startup[7][1 + 2 * first_index : 3 + 2 * first_index]
+        pending_flags = startup[7][3 - 2 * first_index : 5 - 2 * first_index]
+        if active_flags != [3, 3] or any(f not in (0, 1) for f in pending_flags):
+            raise RuntimeError(f"expected only branch {first} active: {startup}")
+        phase("single", [first])
+
+        run.network.set_link(1, cold_owner)
+        deadline = time.monotonic() + 5
+        while time.monotonic() < deadline:
+            # wait() already returns Succeeded while optional edges are pending.
+            # An acknowledged unchanged report can disappear until new facts.
+            # Neither a missing report nor timeout proves that the branch joined.
+            try:
+                joined = run.query(source, allowance_us=250_000)
+            except TimeoutError:
+                joined = None
+            if joined is not None:
+                live_source(joined)
+                if joined[7][1:] == [3, 3, 3, 3]:
+                    break
+                if any(f & 252 for f in joined[7][1:]):
+                    raise RuntimeError(f"optional branch did not join: {joined}")
+            time.sleep(0.01)
+        else:
+            raise TimeoutError("no observed evidence that both branches joined")
+        phase("both", ["A", "B"])
+
+        complete(run.o.remove_edge(source.bindings[first_index], cleanup_us=3_000_000))
+        phase("remaining", [other])
+        complete(run.o.remove_node(source.instance, cleanup_us=3_000_000))
+        complete(
+            run.o.remove_node(sink_a.instance, cleanup_us=3_000_000, no_edges=True)
+        )
+        complete(
+            run.o.remove_node(sink_b.instance, cleanup_us=3_000_000, no_edges=True)
+        )
+        instances = {
+            "10": source.instance.value,
+            "20": sink_a.instance.value,
+            "30": sink_b.instance.value,
+        }
+
+    events = [
+        json.loads(line)
+        for line in (Path(output) / "events.jsonl").read_text().splitlines()
+    ]
+    result = evaluate_alternatives(events, (1, 2, 3), instances, phases)
+    result.update(
+        first=first,
+        instances=instances,
+        windows=phases,
+        startup_report=startup,
+        joined_report=joined,
+        outcomes=outcomes,
+        remaining_instances_at_teardown=[],
+        limitations=[
+            "GET observes host copy-out, not application acceptance or actuation",
+            "Synthetic sample counts; no periodic or freshness claim",
+            "Optional join demonstrated within its original allowance; no restart after expiry",
+        ],
+    )
+    (Path(output) / "result.json").write_text(json.dumps(result, indent=2) + "\n")
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--host", type=Path, required=True)
+    parser.add_argument("--guest", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--first", choices=("A", "B"), default="A")
+    parser.add_argument("--seed", type=int, default=0)
+    args = parser.parse_args()
+    try:
+        result = run_alternatives(**vars(args))
+    except (OSError, RuntimeError, ValueError) as error:
+        parser.exit(2, f"alternative workload failed: {error}\n")
+    print(json.dumps(result, indent=2))
+    if result["status"] != "passed":
+        parser.exit(1)
+
+
+if __name__ == "__main__":
+    main()
