+"""APP04: mixed startup gates and later service are separate observations."""
+
+import json
+import os
+import struct
+import tempfile
+import unittest
+from pathlib import Path
+
+from sim_env.graph_mixed import evaluate_mixed, run_mixed
+
+INSTANCES = {"10": 0, "11": 1, "20": 3, "30": 2}
+OWNERS = {10: 2, 11: 3, 20: 1, 30: 4}
+
+
+def trace(first="A", *, output=True, complete=True, repeated=False):
+    rows, counts = [], {i: 0 for i in (1, 2, 3, 4)}
+    source = 10 if first == "A" else 11
+    for i in range(8):
+        sequence = 2 * (0 if repeated else i) + (source == 11)
+        for logical, direction, channel, transformed in (
+            (source, "PUT", (source, 20, 1), False),
+            (20, "GET", (source, 20, 1), False),
+            *(
+                ((20, "PUT", (20, 30, 1), True), (30, "GET", (20, 30, 1), True))
+                if output
+                else ()
+            ),
+        ):
+            value = 2 * sequence + 1 if transformed else sequence
+            payload = (
+                struct.pack("<II", sequence, value)
+                + bytes((sequence + j) & 255 for j in range(56))
+            ).hex()
+            owner = OWNERS[logical]
+            counts[owner] += 1
+            timestamp = 101 + len(rows)
+            src, dst, service = channel
+            rows.append(
+                {
+                    "kind": "host_stdout",
+                    "device": owner,
+                    "line": f"CHANNEL {counts[owner]} {timestamp} {INSTANCES[str(logical)]} {direction} {src} {dst} {service} {payload}",
+                }
+            )
+    if complete:
+        rows += [
+            {"kind": "host_stdout", "device": i, "line": f"CHANNEL_END {n} 0"}
+            for i, n in counts.items()
+        ]
+    return rows
+
+
+class MixedOracleTests(unittest.TestCase):
+    def evaluate(self, events, *, first="A", output=True):
+        return evaluate_mixed(
+            events,
+            (1, 2, 3, 4),
+            INSTANCES,
+            first,
+            [{"name": "test", "begin_us": 100, "end_us": 200, "output": output}],
+        )
+
+    def test_either_source_has_ordered_transformed_output(self):
+        for first in ("A", "B"):
+            with self.subTest(first=first):
+                result = self.evaluate(trace(first), first=first)
+                self.assertEqual(result["status"], "passed")
+                self.assertEqual(result["phases"][0]["service_status"], "passed")
+                self.assertEqual(result["phases"][0]["output_unique"], 8)
+
+    def test_removed_output_is_expected_service_failure_with_live_input(self):
+        result = self.evaluate(trace(output=False), output=False)
+        self.assertEqual(result["status"], "passed")
+        self.assertEqual(result["phases"][0]["service_status"], "failed")
+        self.assertEqual(result["phases"][0]["input_unique"], 8)
+
+    def test_missing_output_does_not_pass_serving_phase(self):
+        self.assertEqual(self.evaluate(trace(output=False))["status"], "failed")
+
+    def test_copies_on_removed_output_or_wrong_input_fail(self):
+        self.assertEqual(self.evaluate(trace(), output=False)["status"], "failed")
+        self.assertEqual(self.evaluate(trace("B"))["status"], "failed")
+
+    def test_duplicates_do_not_meet_eight_sample_requirement(self):
+        self.assertEqual(self.evaluate(trace(repeated=True))["status"], "failed")
+
+    def test_missing_trace_is_inconclusive_even_when_service_is_expected_to_stop(self):
+        result = self.evaluate(trace(output=False, complete=False), output=False)
+        self.assertEqual(result["status"], "inconclusive")
+
+    def test_wrong_value_padding_instance_owner_and_channel_are_rejected(self):
+        for field, value in (
+            ("value", "bad"),
+            ("padding", "bad"),
+            ("instance", "9"),
+            ("device", 4),
+            ("channel", "12"),
+        ):
+            with self.subTest(field=field):
+                events = trace()
+                fields = events[0]["line"].split()
+                if field in ("value", "padding"):
+                    data = bytearray.fromhex(fields[-1])
+                    data[4 if field == "value" else 63] ^= 1
+                    fields[-1] = data.hex()
+                elif field == "instance":
+                    fields[3] = value
+                elif field == "channel":
+                    fields[5] = value
+                else:
+                    # Move every row/summary from owner 2 to 5, preserving trace
+                    # completeness; owner mismatch must still be rejected.
+                    for event in events:
+                        if event["device"] == 2:
+                            event["device"] = 5
+                    with self.assertRaisesRegex(ValueError, "owner"):
+                        evaluate_mixed(events, (1, 3, 4, 5), INSTANCES, "A", [])
+                    continue
+                events[0]["line"] = " ".join(fields)
+                with self.assertRaises(ValueError):
+                    self.evaluate(events)
+
+    def test_every_copy_requires_its_preceding_hop(self):
+        for index in (1, 2, 3):
+            with self.subTest(index=index):
+                events = trace()
+                fields = events[index]["line"].split()
+                fields[2] = "100"  # Before its required preceding hop.
+                events[index]["line"] = " ".join(fields)
+                with self.assertRaisesRegex(ValueError, "preceding"):
+                    self.evaluate(events)
+
+    def test_input_source_identity_is_not_interchangeable(self):
+        events = trace()
+        for event in events:
+            if " 10 20 1 " in event["line"]:
+                event["line"] = event["line"].replace(" 10 20 1 ", " 11 20 1 ")
+                if " PUT " in event["line"]:
+                    event["line"] = event["line"].replace(" 0 PUT ", " 1 PUT ")
+                    event["device"] = 3
+            if event["line"] == "CHANNEL_END 8 0" and event["device"] == 2:
+                event["device"] = 3
+            elif event["line"] == "CHANNEL_END 0 0" and event["device"] == 3:
+                event["device"] = 2
+        with self.assertRaisesRegex(ValueError, "source"):
+            self.evaluate(events)
+
+
+@unittest.skipUnless(
+    os.environ.get("KAOS_WORKLOAD_HOST"), "requires actual host and guests"
+)
+class MixedProcessTests(unittest.TestCase):
+    def check_flow(self, first, missing):
+        with tempfile.TemporaryDirectory(prefix="kaos-mixed-test-") as directory:
+            output = Path(directory) / "run"
+            result = run_mixed(
+                os.environ["KAOS_WORKLOAD_HOST"],
+                Path(os.environ["KAOS_WORKLOAD_GUESTS"]) / "mixed.wasm",
+                output,
+                first=first,
+                missing=missing,
+                seed=42,
+            )
+            self.assertEqual(result["status"], "passed", result)
+            self.assertTrue(result["trace_complete"])
+            self.assertEqual(len(result["outcomes"]), 9)
+            self.assertTrue(all(o["report"][5] == 1 for o in result["outcomes"]))
+            blocked = result["blocked_report"]
+            self.assertEqual(blocked[5:7], [0, 0])
+            self.assertEqual(blocked[7][0], 1)
+            selected = 1 if first == "A" else 3
+            if missing == "output":
+                self.assertEqual(blocked[7][selected : selected + 2], [1, 1])
+                self.assertEqual(blocked[7][6], 0)
+            else:
+                self.assertEqual(blocked[7][5:], [1, 1])
+                self.assertEqual([blocked[7][1], blocked[7][3]], [0, 0])
+            initial = result["startup_report"]
+            self.assertEqual(initial[6], 39)
+            self.assertEqual(initial[7][selected : selected + 2], [3, 3])
+            self.assertEqual(initial[7][5:], [3, 3])
+            self.assertGreater(initial[4], blocked[4])
+            removed = result["outcomes"][4]["report"]
+            self.assertTrue(all(flags & 56 == 56 for flags in removed[7]))
+            self.assertEqual(
+                [p["service_status"] for p in result["phases"]], ["passed", "failed"]
+            )
+            self.assertEqual(result["remaining_instances_at_teardown"], [])
+            self.assertEqual(json.loads((output / "result.json").read_text()), result)
+
+    def test_a_waits_for_output(self):
+        self.check_flow("A", "output")
+
+    def test_b_waits_for_output(self):
+        self.check_flow("B", "output")
+
+    def test_output_waits_for_a(self):
+        self.check_flow("A", "inputs")
+
+    def test_output_waits_for_b(self):
+        self.check_flow("B", "inputs")
+
+
+if __name__ == "__main__":
+    unittest.main()
