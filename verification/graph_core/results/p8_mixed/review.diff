+"""APP04: (input A OR input B) AND output, with separate service observations."""
+
+import argparse
+import json
+import struct
+import time
+from pathlib import Path
+
+from .graph_protocol import Channel, Endpoint, Node, Port
+from .graph_run import GraphRun
+from .graph_transport import CREATED
+from .graph_workloads import read_trace
+
+INPUTS = {"A": (10, 20, 1), "B": (11, 20, 1)}
+OUTPUT = (20, 30, 1)
+OWNERS = {10: 2, 11: 3, 20: 1, 30: 4}
+
+
+def evaluate_mixed(events, devices, instances, first, phases):
+    """Validate ordered copy chains and distinguish expected service loss."""
+    if first not in INPUTS:
+        raise ValueError("first must be A or B")
+    records, complete = read_trace(events, devices)
+    if not complete:
+        return {"status": "inconclusive", "trace_complete": False}
+    instances = {int(k): v for k, v in instances.items()}
+    copies = {}
+    for record in records:
+        channel, data = record["channel"], record["payload"]
+        if channel not in (*INPUTS.values(), OUTPUT):
+            raise ValueError("unexpected channel")
+        logical = channel[0] if record["direction"] == "PUT" else channel[1]
+        if record["instance"] != instances[logical]:
+            raise ValueError("unexpected concrete instance")
+        if record["device"] != OWNERS[logical]:
+            raise ValueError("unexpected owner")
+        if len(data) != 64:
+            raise ValueError("fixture sample must contain 64 bytes")
+        sequence, value = struct.unpack_from("<II", data)
+        expected = (2 * sequence + 1) & 0xFFFFFFFF if channel == OUTPUT else sequence
+        if value != expected or data[8:] != bytes(
+            (sequence + i) & 255 for i in range(56)
+        ):
+            raise ValueError("incorrect fixture value or padding")
+        if channel != OUTPUT and sequence % 2 != channel[0] - 10:
+            raise ValueError("sample belongs to the other input source")
+        key = (channel, record["direction"], sequence)
+        copies[key] = min(
+            copies.get(key, record["timestamp_us"]), record["timestamp_us"]
+        )
+    for record in records:
+        sequence = struct.unpack_from("<I", record["payload"])[0]
+        channel, direction = record["channel"], record["direction"]
+        if direction == "GET":
+            previous = (channel, "PUT", sequence)
+        elif channel == OUTPUT:
+            previous = ((10 + sequence % 2, 20, 1), "GET", sequence)
+        else:
+            continue
+        if previous not in copies or copies[previous] > record["timestamp_us"]:
+            raise ValueError("copy without its preceding matching hop")
+
+    results = []
+    for phase in phases:
+        if not 0 <= phase["begin_us"] < phase["end_us"]:
+            raise ValueError("phase must have increasing nonnegative times")
+        window = [
+            r
+            for r in records
+            if phase["begin_us"] <= r["timestamp_us"] < phase["end_us"]
+        ]
+        input_sequences = {
+            struct.unpack_from("<I", r["payload"])[0]
+            for r in window
+            if r["channel"] == INPUTS[first] and r["direction"] == "GET"
+        }
+        output_sequences = {
+            struct.unpack_from("<I", r["payload"])[0]
+            for r in window
+            if r["channel"] == OUTPUT and r["direction"] == "GET"
+        }
+        unexpected = sum(
+            r["channel"] not in (INPUTS[first], OUTPUT)
+            or (r["channel"] == OUTPUT and not phase["output"])
+            for r in window
+        )
+        service = len(output_sequences) >= 8
+        good = (
+            len(input_sequences) >= 8 and not unexpected and service == phase["output"]
+        )
+        results.append(
+            {
+                "name": phase["name"],
+                "status": "passed" if good else "failed",
+                "service_status": "passed" if service else "failed",
+                "input_unique": len(input_sequences),
+                "output_unique": len(output_sequences),
+                "unexpected_copies": unexpected,
+            }
+        )
+    return {
+        "status": "passed"
+        if results and all(p["status"] == "passed" for p in results)
+        else "failed",
+        "trace_complete": True,
+        "observations": len(records),
+        "phases": results,
+        "scope": "eight distinct selected-input GETs; eight output GETs when serving, zero output copies after removal",
+    }
+
+
+def run_mixed(host, guest, output, *, first="A", missing="output", seed=0):
+    """Observe an unsatisfied gate, release it, then remove required output."""
+    if first not in INPUTS or missing not in ("output", "inputs"):
+        raise ValueError("first must be A/B and missing must be output/inputs")
+    selected = 0 if first == "A" else 1
+    cold_owner = 3 - selected
+    selected_owner = 2 + selected
+    outcomes, phases = [], []
+    with GraphRun(host, output, (1, 2, 3, 4), seed=seed, trace_channels=True) as run:
+        size, crc = run.add_artifact(b"mixed", Path(guest).read_bytes())
+
+        def admit(request):
+            if run.submit(request).code != CREATED:
+                raise RuntimeError("mixed workload operation was not admitted")
+
+        def finish(request):
+            report = run.wait(request, timeout_s=10)
+            outcomes.append(
+                {
+                    "operation": request.operation.value,
+                    "kind": int(request.kind),
+                    "report": report,
+                }
+            )
+            if report[5] != 1:
+                raise RuntimeError(
+                    f"mixed workload operation did not succeed: {report}"
+                )
+            return report
+
+        def complete(request):
+            admit(request)
+            finish(request)
+            return request
+
+        def node(logical, role):
+            return Node(
+                logical,
+                OWNERS[logical],
+                b"mixed",
+                size,
+                crc,
+                131072,
+                bytes([role]),
+                10_000_000,
+                3_000_000,
+                (Port(1, 0, 1, 64), Port(2, 1, 1, 64)),
+            )
+
+        def phase(name, has_output):
+            begin = time.monotonic_ns() // 1000
+            run.emit("workload_phase_begin", name=name, output=has_output)
+            time.sleep(0.25)
+            end = time.monotonic_ns() // 1000
+            run.emit("workload_phase_end", name=name)
+            phases.append(
+                {
+                    "name": name,
+                    "begin_us": begin,
+                    "end_us": end,
+                    "output": has_output,
+                }
+            )
+
+        source_a = complete(run.o.add_node(node(10, 0)))
+        source_b = complete(run.o.add_node(node(11, 1)))
+        sink = complete(run.o.add_node(node(30, 3)))
+        for owner in (cold_owner, 4) if missing == "output" else (2, 3):
+            run.network.set_link(1, owner, loss=1)
+        channels = tuple(
+            Channel(
+                Endpoint(logical, source.instance, owner, 2),
+                Endpoint(20, None, 1, 1),
+                1,
+                1,
+                64,
+                2,
+                10_000_000,
+            )
+            for logical, owner, source in ((10, 2, source_a), (11, 3, source_b))
+        ) + (
+            Channel(
+                Endpoint(20, None, 1, 2),
+                Endpoint(30, sink.instance, 4, 1),
+                1,
+                1,
+                64,
+                2,
+                10_000_000,
+            ),
+        )
+        controller = run.o.add_node(
+            node(20, 2),
+            channels=channels,
+            predicate_tokens=b"\x02\x00\x02\x01\x04\x00\x02\x02\x03\x00",  # A B OR O AND
+        )
+        admit(controller)
+        deadline = time.monotonic() + 5
+        while time.monotonic() < deadline:
+            try:
+                blocked = run.query(controller, allowance_us=250_000)
+            except TimeoutError:
+                blocked = None
+            # ACKed unchanged reports can disappear; missing evidence cannot
+            # satisfy this gate. Wait for actual preparation of the other side.
+            if blocked is not None:
+                flags = blocked[7]  # node, A src/dst, B src/dst, output src/dst
+                if (
+                    blocked[5:7] != [0, 0]
+                    or len(flags) != 7
+                    or any(f & ~1 for f in flags)
+                ):
+                    raise RuntimeError(
+                        f"controller advanced before its gate: {blocked}"
+                    )
+                ready = (
+                    flags[1 + 2 * selected : 3 + 2 * selected] == [1, 1]
+                    and flags[6] == 0
+                    if missing == "output"
+                    else flags[5:] == [1, 1] and flags[1] == flags[3] == 0
+                )
+                if flags[0] == 1 and ready:
+                    break
+            time.sleep(0.01)
+        else:
+            raise TimeoutError("no positive evidence of the blocked startup gate")
+        run.emit("workload_gate", missing=missing, first=first, report=blocked)
+        run.network.set_link(1, 4 if missing == "output" else selected_owner)
+        startup = finish(controller)
+        flags = startup[7]
+        if (
+            startup[6] != 39  # committed, dispatched, started, succeeded
+            or flags[0] != 1
+            or flags[1 + 2 * selected : 3 + 2 * selected] != [3, 3]
+            or flags[5:] != [3, 3]
+            or any(f not in (0, 1) for f in flags[3 - 2 * selected : 5 - 2 * selected])
+        ):
+            raise RuntimeError(f"missing mixed startup evidence: {startup}")
+        phase("serving", True)
+        complete(run.o.remove_edge(controller.bindings[2], cleanup_us=3_000_000))
+        phase("output_removed", False)
+
+        # Restore the unused input path so every authorized role can close.
+        run.network.set_link(1, cold_owner)
+        complete(run.o.remove_node(controller.instance, cleanup_us=3_000_000))
+        for peer in (source_a, source_b, sink):
+            complete(
+                run.o.remove_node(peer.instance, cleanup_us=3_000_000, no_edges=True)
+            )
+        instances = {
+            "10": source_a.instance.value,
+            "11": source_b.instance.value,
+            "20": controller.instance.value,
+            "30": sink.instance.value,
+        }
+
+    events = [
+        json.loads(line)
+        for line in (Path(output) / "events.jsonl").read_text().splitlines()
+    ]
+    result = evaluate_mixed(events, (1, 2, 3, 4), instances, first, phases)
+    result.update(
+        first=first,
+        missing=missing,
+        instances=instances,
+        windows=phases,
+        blocked_report=blocked,
+        startup_report=startup,
+        outcomes=outcomes,
+        remaining_instances_at_teardown=[],
+        limitations=[
+            "GET observes host copy-out, not application acceptance or actuation",
+            "Eight-sample synthetic service criterion; no periodic or freshness claim",
+            "Startup success is historical; removing required output ends output service",
+        ],
+    )
+    (Path(output) / "result.json").write_text(json.dumps(result, indent=2) + "\n")
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--host", type=Path, required=True)
+    parser.add_argument("--guest", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--first", choices=("A", "B"), default="A")
+    parser.add_argument("--missing", choices=("output", "inputs"), default="output")
+    parser.add_argument("--seed", type=int, default=0)
+    args = parser.parse_args()
+    try:
+        result = run_mixed(**vars(args))
+    except (OSError, RuntimeError, ValueError) as error:
+        parser.exit(2, f"mixed workload failed: {error}\n")
+    print(json.dumps(result, indent=2))
+    if result["status"] != "passed":
+        parser.exit(1)
+
+
+if __name__ == "__main__":
+    main()
